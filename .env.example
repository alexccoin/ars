# A.R.S configuration — copy to .env and fill in. NEVER commit .env.
# Anything unset falls back to a local/offline default.

# ---- Runtime ----
ARS_ENV=dev
ARS_DATA_DIR=./var
ARS_LOG_LEVEL=INFO

# ---- Language ----
# Languages the assistant understands and speaks. First is the default.
ARS_LANGUAGES=en,ro,de

# ---- Reasoning backend ----
# local | anthropic   (local = Ollama; anthropic = cloud API)
ARS_LLM_BACKEND=local
ARS_LLM_LOCAL_MODEL=qwen3:14b
ARS_LLM_LOCAL_HOST=http://127.0.0.1:11434
ANTHROPIC_API_KEY=
ARS_LLM_CLOUD_MODEL=claude-sonnet-5

# ---- Voice ----
ARS_ASR_MODEL=large-v3-turbo
# mlx-whisper (Apple Silicon GPU) or faster-whisper (portable, CPU). Unset takes the
# platform default: mlx-whisper on arm64 macOS, faster-whisper elsewhere.
# ARS_ASR_BACKEND=mlx-whisper
ARS_ASR_COMPUTE_TYPE=int8   # faster-whisper only
ARS_TTS_VOICE_EN=en_US-amy-medium
ARS_TTS_VOICE_RO=ro_RO-mihai-medium
ARS_WAKEWORD=hey_ars

# ---- Guard ----
# Master switch: when false, no skill may touch private data regardless of grants.
ARS_GUARD_ENABLED=true
ARS_GUARD_AUDIT_LOG=./var/audit.jsonl

# ---- Skills: search & scraping ----
BRAVE_SEARCH_API_KEY=
GITHUB_TOKEN=

# ---- Skills: email (OAuth handled by the auth service; no passwords here) ----
ARS_EMAIL_PROVIDER=

# A clinical reference for the medical tools — AresMed, or anything with the same shape.
# Leave unset and the medical skill is not registered at all: a tool whose every call
# fails with "not configured" is worse than an absent one, because the model offers it,
# calls it, and reports an error the user cannot act on.
#
# ARS_MEDICAL_KEY is for a PUBLISHABLE key only — a Supabase anon key is designed to ship
# in client JavaScript and is useless without the row-level security behind it. Anything
# stronger belongs in the token vault under 'aresmed', which the reasoning layer cannot
# read at all.
ARS_MEDICAL_URL=
ARS_MEDICAL_KEY=
