# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
dist/
build/
.next/
*.tsbuildinfo

# Models — never commit weights (CLAUDE.md non-negotiable #8).
# Ignore everything under models/ and allow back only documentation. Listing weight
# EXTENSIONS is not enough: a whisper checkout also carries tokenizer.json,
# vocabulary.json and .tflite, and Piper carries .onnx.json — none of which match a
# weights glob, and all of which would have been committed. Populate models/ with
# scripts/fetch_voice_models.sh.
models/*
!models/README.md
data/datasets/**/raw/
*.wav
*.mp3
*.flac
!data/fixtures/**/*.wav

# Runtime state — contains user data
var/
*.db
*.sqlite
*.sqlite3
*.log
audit.jsonl
vault.keys/
*.fernet

# Secrets — see security/policies/secrets.md
.env
.env.*
!.env.example
security/keys/*
!security/keys/README.md
!security/keys/*.md
*.pem
*.key
credentials.json
token.json

# OS / editor
.DS_Store
.idea/
*.swp

# Screenshots and renders produced while verifying the interface. Evidence for a review,
# not source: they are large, they change on every run, and nothing builds from them.
.artifacts/
var/voice-auditions/
